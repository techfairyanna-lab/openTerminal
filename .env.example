# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or .env.local and populate with your actual settings.
# Do NOT commit .env or files containing sensitive credentials to source control.
# ==============================================================================

# Application & API Settings
VITE_APP_TITLE=The Backrooms: Linux Liminality
VITE_API_BASE_URL=http://localhost:3000
VITE_API_KEY=your_api_key_here

# Server Network Settings
SERVER_HOST=localhost
SERVER_PORT=3000

# Database Connection Strings (if connecting to backend services)
# Examples:
# DATABASE_URL=postgresql://dbuser:dbpassword@localhost:5432/game_db
# MONGODB_URI=mongodb://dbuser:dbpassword@localhost:27017/game_db
# REDIS_URL=redis://:redispassword@localhost:6379/0
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
MONGODB_URI=mongodb://localhost:27017/dbname

# Author / Maintainer Info (placeholders for open-source setup)
MAINTAINER_NAME=Your Name
MAINTAINER_EMAIL=your.email@example.com
